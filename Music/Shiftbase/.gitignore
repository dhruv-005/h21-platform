# ============================================
# SHIFTBASE - Git Ignore Rules
# ============================================

# Environment
.env
.env.local
.env.production

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
backend/venv/
backend/.venv/

# Database
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Node / Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Docker
docker-compose.override.yml